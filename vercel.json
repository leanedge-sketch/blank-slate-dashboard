{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 180,
      "excludeFiles": "{frontend/**,docs/**,migrations/**,supabase/**,scripts/**,src/**,data/**,qoute_format/**,.lovable/**,.tanstack/**,backend/tests/**,node_modules/**,*.md,*.pdf,*.xlsx,*.docx,streamlit_app.py}"
    }
  },
  "buildCommand": "cd frontend && npm run build && rm -rf node_modules",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci",
  "framework": "vite",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "blank-slate-dashboard-gcsx.vercel.app" }],
      "destination": "https://blank-slate-dashboard-plum.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "integrated-deal-and-product-system.vercel.app" }],
      "destination": "https://blank-slate-dashboard-plum.vercel.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/executive-briefing",
      "schedule": "0 5 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# Copy to .env for local development (never commit .env)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI (primary gpt-4o + secondary gpt-4o-mini chat fallback)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
MODEL_CHOICE=gpt-4o

# Gemini (Flash for everyday + ICP; Pro for Monday executive briefing only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
EXECUTIVE_BRIEFING_GEMINI_MODEL=gemini-3.1-pro-preview
# Monthly Gemini spend cap (USD) — Telegram alerts at 75% and 90%
GEMINI_MONTHLY_BUDGET_USD=50

# Frontend (optional for local Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Loop A / public-site RFQ inbox (also set these on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-loop-a-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-loop-a-anon-jwt
LOOP_A_SUPABASE_URL=https://your-loop-a-project.supabase.co
LOOP_A_SUPABASE_ANON_KEY=your-loop-a-anon-jwt
VITE_LOOP_A_SUPABASE_URL=https://your-loop-a-project.supabase.co
VITE_LOOP_A_SUPABASE_ANON_KEY=your-loop-a-anon-jwt

# Telegram CRM notifications (same bot as imported history)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_ENABLED=true

# Email (optional — password change verification)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=LeanChem Connect <noreply@yourdomain.com>
